.claude/*.local.md
.claude/settings.local.json
.claude/worktrees/

# Local scratch (never commit renders you did not mean to)
/scratch
/fixtures/_local

# Python sidecar environment (ADR-009)
sidecar/.venv/
__pycache__/

# Example build output
examples/*/build/
